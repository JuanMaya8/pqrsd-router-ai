# Directory where the trained model is persisted (joblib). Empty = trained in memory at every boot (~8 s).
MODELS_DIR=./models
# Append-only JSON Lines log of staff corrections (the real training data). Empty = in memory only.
FEEDBACK_FILE=./data/feedback.jsonl
# Optional JSON with your own dependencies (same shape as GET /v1/taxonomy). Empty = built-in municipal taxonomy.
TAXONOMY_FILE=
# If set, every /v1/* request must send header X-API-Key with this value.
AI_API_KEY=
# Comma-separated browser origins allowed by CORS (the backend calls server-to-server, so usually empty).
CORS_ORIGINS=
# Size of the synthetic cold-start corpus used when no persisted model exists.
BOOTSTRAP_SAMPLES=6000
